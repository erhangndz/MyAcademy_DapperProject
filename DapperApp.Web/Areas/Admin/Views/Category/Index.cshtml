
@model IEnumerable<ResultCategoryDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int count = 0;
}

<h3>Kategoriler</h3>

<table class="table table-hover table-bordered">
    <tr>
        <th>#</th>
        <th>Kategori Adı</th>
        <th>İşlemler</th>
    </tr>

    @foreach (var item in Model)
    {
        count++;
        <tr>
            <th>@count</th>
            <td>@item.Name</td>
            <td>
                <a href="/Admin/Category/Delete/@item.CategoryId" onclick="return confirm('Silmek istediğinize emin misiniz?')" class="btn btn-outline-danger">Sil</a>
                <a href="/Admin/Category/Update/@item.CategoryId" class="btn btn-outline-info">Güncelle</a>

            </td>
        </tr>
    }

</table>
<a href="/Admin/Category/Create" class="btn btn-outline-dark">Yeni Kategori Oluştur</a>